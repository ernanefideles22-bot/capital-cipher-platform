# Copy to deploy/testnet/.env. This file is a template only; never commit the
# copy with real values. The global .gitignore excludes .env files.
TESTNET_POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_URL_SAFE_CHARACTERS
TESTNET_REDIS_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_URL_SAFE_CHARACTERS
ADMIN_API_KEY=REPLACE_WITH_32_PLUS_RANDOM_URL_SAFE_CHARACTERS

# Bybit TESTNET credentials. Use keys created in the Bybit TESTNET account;
# do not use production keys and do not paste values into Git or chat.
CAPITAL_CIPHER_BYBIT_TESTNET_KEY_ID=REPLACE_WITH_BYBIT_TESTNET_KEY
CAPITAL_CIPHER_BYBIT_TESTNET_SIGNING_SECRET=REPLACE_WITH_BYBIT_TESTNET_SECRET

TESTNET_BACKEND_PORT=8001
TESTNET_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8001
LOG_LEVEL=INFO
